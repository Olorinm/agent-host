{
  "name": "@olorinm/agent-host",
  "version": "0.1.0-alpha.11",
  "description": "Product-independent native Agent sessions, tools and interaction routing",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-host.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "examples/file-editor/cli.mjs",
    "examples/file-editor/editor.mjs",
    "examples/file-editor/package.json",
    "examples/http-editor/app.js",
    "examples/http-editor/server.mjs",
    "examples/http-editor/index.html",
    "examples/http-editor/README.md",
    "examples/http-editor/package.json",
    "examples/http-editor/host.example.json",
    "plugins",
    "examples/react-editor/app.jsx",
    "examples/react-editor/build.mjs",
    "examples/react-editor/editor.css",
    "examples/react-editor/index.html",
    "examples/react-editor/README.md",
    "examples/react-editor/server.mjs",
    "examples/cloud"
  ],
  "exports": {
    "./server": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./client": {
      "types": "./dist/service/client.d.ts",
      "import": "./dist/service/client.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    },
    "./environment/windows-discovery": {
      "types": "./dist/environment/windows-discovery.d.ts",
      "import": "./dist/environment/windows-discovery.js"
    },
    "./environment/windows-query": {
      "types": "./dist/environment/windows-query.d.ts",
      "import": "./dist/environment/windows-query.js"
    },
    "./transport": {
      "types": "./dist/transport/stdio-json-rpc-client.d.ts",
      "import": "./dist/transport/stdio-json-rpc-client.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "import": "./dist/acp/index.js"
    },
    "./acp/mcp-server": "./dist/acp/mcp-server.js",
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./native-session-lock": {
      "types": "./dist/native-session-lock.d.ts",
      "import": "./dist/native-session-lock.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./hermes": {
      "types": "./dist/hermes/index.d.ts",
      "import": "./dist/hermes/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw/index.d.ts",
      "import": "./dist/openclaw/index.js"
    },
    "./openclaw/plugin": {
      "types": "./dist/openclaw/plugin.d.ts",
      "import": "./dist/openclaw/plugin.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    }
  },
  "bin": {
    "agent-host": "dist/service/cli.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "probe:codex": "node scripts/probe-codex.mjs",
    "test:ui:package": "node scripts/test-ui-package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cross-spawn": "7.0.6",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@moonshot-ai/kimi-code": "2.2.0",
    "@olorinm/agent-ui": "https://github.com/Olorinm/agent-ui/releases/download/v0.1.0-alpha.2/olorinm-agent-ui-0.1.0-alpha.2.tgz",
    "@openai/codex": "0.165.0",
    "@opencode/cli": "2.0.29",
    "@playwright/test": "1.63.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
